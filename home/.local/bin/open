#!/usr/bin/env bun
// Cross-platform open(1), preserving child stdio and exit status.

import { accessSync, constants } from "node:fs";

function executable(path) {
  try {
    accessSync(path, constants.X_OK);
    return true;
  } catch {
    return false;
  }
}

export function openCommand(platform = process.platform) {
  if (platform === "darwin" && executable("/usr/bin/open")) return ["/usr/bin/open"];
  if (platform === "win32") return ["cmd.exe", "/d", "/s", "/c", "start", ""];
  return ["xdg-open"];
}

export async function main(args = process.argv.slice(2)) {
  try {
    const child = Bun.spawn([...openCommand(), ...args], {
      stdin: "inherit",
      stdout: "inherit",
      stderr: "inherit",
    });
    return await child.exited;
  } catch (error) {
    console.error(`open: ${error instanceof Error ? error.message : String(error)}`);
    return 127;
  }
}

if (import.meta.main) process.exit(await main());
