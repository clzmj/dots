			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#ffcfa8</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Errors</string>
			<key>scope</key>
			<string>invalid, invalid.illegal</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#ff8080</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Deprecated syntax</string>
			<key>scope</key>
			<string>invalid.deprecated</string>
			<key>settings</key>
			<dict>
