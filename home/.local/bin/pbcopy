#!/usr/bin/env bun
// pbcopy(1) everywhere: native macOS, Wayland, then X11.

import { accessSync, constants } from "node:fs";

function executable(path) {
  try {
    accessSync(path, constants.X_OK);
    return true;
  } catch {
    return false;
  }
}

export function copyCommand(platform = process.platform, which = Bun.which, env = process.env) {
  if (platform === "darwin" && executable("/usr/bin/pbcopy")) return ["/usr/bin/pbcopy"];
  const wayland = Boolean(env.WAYLAND_DISPLAY) || env.XDG_SESSION_TYPE?.toLowerCase() === "wayland";
  if (wayland && which("wl-copy")) return ["wl-copy"];
  if (which("xclip")) return ["xclip", "-selection", "clipboard"];
  throw new Error(wayland ? "pbcopy needs wl-copy (Wayland)" : "pbcopy needs xclip (X11)");
}

export async function main(args = process.argv.slice(2)) {
  try {
    const child = Bun.spawn([...copyCommand(), ...args], {
      stdin: "inherit",
      stdout: "inherit",
      stderr: "inherit",
    });
    return await child.exited;
  } catch (error) {
    console.error(error instanceof Error ? error.message : String(error));
    return 127;
  }
}

if (import.meta.main) process.exit(await main());
