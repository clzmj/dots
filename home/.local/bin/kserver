#!/usr/bin/env bun
// Find listening development servers and stop any selected set safely.

import { basename } from "node:path";
import { createInterface } from "node:readline/promises";

const DEV_NAMES = [
  "node",
  "python",
  "python3",
  "uv",
  "go",
  "java",
  "npm",
  "yarn",
  "pnpm",
  "bun",
  "deno",
  "cargo",
  "ruby",
  "php",
  "artisan",
  "uvicorn",
  "gunicorn",
  "dotnet",
  "main",
];

const DEV_PATTERNS = [
  "go run",
  "npm run",
  "yarn start",
  "pnpm run",
  "bun run",
  "uv run",
  "php artisan serve",
  "http.server",
  "uvicorn",
  "gunicorn",
];

export function parseLsof(output) {
  const byPid = new Map();
  let current = null;
  for (const raw of output.split("\n")) {
    if (!raw) continue;
    const field = raw[0];
    const value = raw.slice(1);
    if (field === "p") {
      const pid = Number(value);
      current = Number.isSafeInteger(pid) ? { pid, name: "", ports: new Set() } : null;
      if (current) byPid.set(pid, current);
    } else if (current && field === "c") {
      current.name = value;
    } else if (current && field === "n") {
      const match = value.match(/:(\d+)(?:\s|$|\(LISTEN\))/);
      if (match) current.ports.add(Number(match[1]));
    }
  }
  return [...byPid.values()].map((item) => ({
    ...item,
    ports: [...item.ports].sort((a, b) => a - b),
  }));
}

export function isDevelopmentServer(name, command) {
  const lowerName = basename(name.toLowerCase());
  const lowerCommand = command.toLowerCase();
  return (
    DEV_NAMES.some(
      (candidate) =>
        lowerName === candidate ||
        lowerName.startsWith(`${candidate}-`) ||
        lowerName.startsWith(`${candidate}.`),
    ) || DEV_PATTERNS.some((pattern) => lowerCommand.includes(pattern))
  );
}

export function parseSelection(value, count) {
  const input = value.trim().toLowerCase();
  if (input === "all" || input === "a") return Array.from({ length: count }, (_, index) => index);
  if (!input) throw new Error("empty selection");
  const selected = new Set();
  for (const token of input.split(/[\s,]+/)) {
    const range = token.match(/^(\d+)-(\d+)$/);
    if (range) {
      const start = Number(range[1]);
      const end = Number(range[2]);
      if (start > end) throw new Error(`invalid range: ${token}`);
      for (let number = start; number <= end; number++) selected.add(number - 1);
    } else if (/^\d+$/.test(token)) {
      selected.add(Number(token) - 1);
    } else {
      throw new Error(`invalid selection: ${token}`);
    }
  }
  if ([...selected].some((index) => index < 0 || index >= count))
    throw new Error("selection is out of range");
  return [...selected].sort((a, b) => a - b);
}

function displayCommand(command, fallback) {
  const lower = command.toLowerCase();
  for (const pattern of DEV_PATTERNS) if (lower.includes(pattern)) return pattern;
  const first = command.trim().split(/\s+/, 1)[0];
  return first ? basename(first) : fallback;
}

function fit(value, width) {
  const displayWidth = Bun.stringWidth(value);
  if (displayWidth <= width) return `${value}${" ".repeat(width - displayWidth)}`;
  return `${Bun.sliceAnsi(value, 0, width - 1)}…`;
}

async function commandFor(pid) {
  const child = Bun.spawn(["ps", "-p", String(pid), "-o", "command="], {
    stdout: "pipe",
    stderr: "ignore",
  });
  const output = (await new Response(child.stdout).text()).trim();
  return (await child.exited) === 0 ? output : "";
}

async function invokeSignal(pid, signal) {
  if (!Number.isSafeInteger(pid) || pid <= 1 || pid === process.pid || pid === process.ppid) {
    throw new Error(`refusing unsafe PID ${pid}`);
  }
  const hook = process.env.DOTS_KSERVER_SIGNAL_COMMAND;
  if (hook) {
    const child = Bun.spawn([hook, signal, String(pid)], { stdout: "ignore", stderr: "ignore" });
    return (await child.exited) === 0;
  }
  try {
    process.kill(pid, signal === "0" ? 0 : signal);
    return true;
  } catch (error) {
    if (error && typeof error === "object" && error.code === "ESRCH") return false;
    throw error;
  }
}

async function isAlive(pid) {
  return await invokeSignal(pid, "0");
}

async function waitForExit(pid, timeoutMs) {
  const deadline = performance.now() + timeoutMs;
  while (performance.now() < deadline) {
    if (!(await isAlive(pid))) return true;
    await Bun.sleep(100);
  }
  return !(await isAlive(pid));
}

export async function stopProcesses(pids, timeoutMs = 3000) {
  const safe = [...new Set(pids)].filter(
    (pid) => Number.isSafeInteger(pid) && pid > 1 && pid !== process.pid && pid !== process.ppid,
  );
  if (safe.length !== pids.length) throw new Error("selection included an unsafe PID");

  await Promise.all(
    safe.map(async (pid) => {
      await invokeSignal(pid, "SIGTERM");
    }),
  );
  const exited = await Promise.all(safe.map((pid) => waitForExit(pid, timeoutMs)));
  const survivors = safe.filter((_, index) => !exited[index]);
  await Promise.all(
    survivors.map(async (pid) => {
      await invokeSignal(pid, "SIGKILL");
    }),
  );
  if (survivors.length)
    await Promise.all(survivors.map((pid) => waitForExit(pid, Math.min(timeoutMs, 1000))));
  return survivors;
}

export async function main() {
  if (!Bun.which("lsof")) {
    console.error("kserver needs lsof (brew install lsof / apt install lsof)");
    return 1;
  }

  console.log("Finding running developer server processes...\n");
  const lsof = Bun.spawn(["lsof", "-nP", "-iTCP", "-sTCP:LISTEN", "-Fpcn"], {
    stdout: "pipe",
    stderr: "ignore",
  });
  const parsed = parseLsof(await new Response(lsof.stdout).text());
  await lsof.exited;

  const inspected = await Promise.all(
    parsed.map(async (item) => ({ ...item, command: await commandFor(item.pid) })),
  );
  const servers = inspected.filter(
    (item) => item.ports.length && isDevelopmentServer(item.name, item.command),
  );
  if (servers.length === 0) {
    console.log("No running developer server processes found.");
    return 0;
  }

  console.log("  #   PID       Port(s)          Command");
  servers.forEach((server, index) => {
    const row = [
      String(index + 1).padStart(3),
      String(server.pid).padEnd(9),
      fit(server.ports.join(","), 16),
      fit(displayCommand(server.command, server.name), 50).trimEnd(),
    ];
    console.log(`  ${row.join(" ")}`);
  });

  const rl = createInterface({ input: process.stdin, output: process.stdout });
  try {
    const answer = await rl.question("\nSelect processes (1,3-5 or all; q to quit): ");
    if (["q", "quit"].includes(answer.trim().toLowerCase())) return 0;
    const indexes = parseSelection(answer, servers.length);
    const chosen = indexes.map((index) => servers[index]);
    const pids = chosen.map((server) => server.pid);
    const confirmation = await rl.question(`Send SIGTERM to PIDs ${pids.join(", ")}? (y/N): `);
    if (!/^y(?:es)?$/i.test(confirmation.trim())) {
      console.log("Aborted.");
      return 0;
    }

    const timeout = Number(process.env.DOTS_KSERVER_TIMEOUT_MS || 3000);
    const survivors = await stopProcesses(
      pids,
      Number.isFinite(timeout) && timeout >= 0 ? timeout : 3000,
    );
    if (survivors.length) console.log(`Escalated to SIGKILL: ${survivors.join(", ")}`);
    console.log(`Stopped ${pids.length} process${pids.length === 1 ? "" : "es"}.`);
    return 0;
  } catch (error) {
    console.error(`kserver: ${error instanceof Error ? error.message : String(error)}`);
    return 1;
  } finally {
    rl.close();
  }
}

if (import.meta.main) process.exit(await main());
