			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#99ffe4</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Diff deletions</string>
			<key>scope</key>
			<string>markup.deleted, markup.deleted.diff</string>
			<key>settings</key>
			<dict>
				<key>foreground</key>
				<string>#ff8080</string>
			</dict>
		</dict>
		<dict>
			<key>name</key>
			<string>Diff changes</string>
			<key>scope</key>
