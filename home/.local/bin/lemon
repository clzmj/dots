#!/usr/bin/env bun

import { runInfo } from "./.lemon/packages/info/src/cli";
import { runPorts } from "./.lemon/packages/ports/src/cli";
import { runRepo } from "./.lemon/packages/repo/src/cli";
import { runNotify } from "./.lemon/packages/run/src/cli";
import { CliOption } from "./.lemon/shared/tokens";

import pkg from "./.lemon/package.json";

export interface CliIO {
  readonly out: (message: string) => void;
  readonly error: (message: string) => void;
}

export enum CommandName {
  Info = "info",
  Repo = "repo",
  Ports = "ports",
  Notify = "notify",
}

enum MetaCommand {
  Help = "help",
}

export const commands = {
  [CommandName.Info]: { summary: "Show a portable machine report", run: runInfo },
  [CommandName.Repo]: { summary: "Open, print, or copy Git repository links", run: runRepo },
  [CommandName.Ports]: { summary: "List and stop local development servers", run: runPorts },
  [CommandName.Notify]: { summary: "Run a command and notify when it finishes", run: runNotify },
} as const satisfies Record<CommandName, { summary: string; run: typeof runInfo }>;

function commandNamed(value: string) {
  const name = Object.values(CommandName).find((candidate) => candidate === value);
  return name === undefined ? undefined : commands[name];
}

export function help(): string {
  const width = Math.max(...Object.keys(commands).map((name) => name.length));
  const lines = Object.entries(commands)
    .map(([name, command]) => `  ${name.padEnd(width)}  ${command.summary}`)
    .join("\n");
  return `lemon

${pkg.description}

Usage:
  lemon <command> [options]
  lemon help <command>

Commands:
${lines}

Options:
  --help, -h       Show help
  --version, -v    Show version`;
}

export async function main(
  args: readonly string[] = Bun.argv.slice(2),
  io: CliIO = { out: console.log, error: console.error },
): Promise<number> {
  const [first, ...rest] = args;
  if (!first || first === CliOption.Help || first === CliOption.HelpShort) {
    io.out(help());
    return 0;
  }
  if (first === CliOption.Version || first === CliOption.VersionShort) {
    io.out(pkg.version);
    return 0;
  }
  if (first === MetaCommand.Help) {
    const name = rest[0];
    if (!name) {
      io.out(help());
      return 0;
    }
    const command = commandNamed(name);
    if (!command) {
      io.error(`lemon: unknown command: ${name}`);
      return 2;
    }
    return command.run([CliOption.Help]);
  }
  const command = commandNamed(first);
  if (!command) {
    io.error(`lemon: unknown command: ${first}`);
    io.error("Run 'lemon --help' for usage.");
    return 2;
  }
  return command.run(rest);
}

if (import.meta.main) process.exit(await main());
