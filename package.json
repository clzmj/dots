{
  "name": "dots",
  "private": true,
  "scripts": {
    "check": "bun run --parallel format:check lint check:shell check:tests",
    "check:shell": "sh -n setup.sh && dash -n setup.sh && zsh -n home/.zprofile home/.zshrc home/.config/zsh/*.zsh",
    "check:tests": "bun scripts/test.ts --parallel --isolate",
    "format": "bun run --parallel format:oxfmt format:bins",
    "format:oxfmt": "oxfmt --write .",
    "format:bins": "bun scripts/format-bins.ts --write",
    "format:check": "bun run --parallel format:check:oxfmt format:check:bins",
    "format:check:oxfmt": "oxfmt --check .",
    "format:check:bins": "bun scripts/format-bins.ts --check",
    "lint": "bun run --parallel lint:oxlint lint:bins",
    "lint:oxlint": "oxlint --deny-warnings . home/.local/bin/.lemon",
    "lint:bins": "bun scripts/lint-bins.ts",
    "test": "bun scripts/test.ts --parallel --isolate",
    "test:changed": "bun scripts/test.ts --changed --parallel --isolate",
    "test:docker": "docker compose -f test/docker/compose.yml up --build --abort-on-container-failure --remove-orphans"
  },
  "devDependencies": {
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
