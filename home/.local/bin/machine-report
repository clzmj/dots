#!/usr/bin/env bun
// TR-100 Machine Report
// Copyright © 2024, U.S. Graphics, LLC. BSD-3-Clause License.

export type Platform = "darwin" | "linux" | "other";

export interface CommandResult {
  stdout: string;
  stderr: string;
  exitCode: number;
}

export interface ProbeContext {
  platform: Platform;
  env: Readonly<Record<string, string | undefined>>;
  run(command: readonly string[]): Promise<CommandResult>;
  hasCommand(command: string): boolean;
  readText(path: string): Promise<string | undefined>;
  now(): number;
}

export interface OSReport {
  name: string;
  kernel: string;
}

export interface NetworkReport {
  hostname: string;
  machineIP: string;
  clientIP: string;
  dnsIPs: string[];
  currentUser: string;
}

export interface CPUReport {
  model: string;
  cores: number;
  coresPerSocket: number;
  sockets: number;
  hypervisor: string;
  frequencyGHz?: number;
  loadAverage: [number, number, number];
}

export interface MemoryReport {
  usedKiB: number;
  totalKiB: number;
}

export interface DiskReport {
  usedMiB: number;
  totalMiB: number;
}

export interface LoginReport {
  lastLogin: string;
  lastLoginIP?: string;
  uptime: string;
}

export interface MachineReport {
  title: string;
  os: OSReport;
  network: NetworkReport;
  cpu: CPUReport;
  memory: MemoryReport;
  disk: DiskReport;
  login: LoginReport;
}

const MIN_DATA_WIDTH = 20;
const MAX_DATA_WIDTH = 32;
const NAME_WIDTH = 13;

function platformName(value: string): Platform {
  if (value === "darwin" || value === "linux") return value;
  return "other";
}

export function createProbeContext(overrides: Partial<ProbeContext> = {}): ProbeContext {
  const decoder = new TextDecoder();
  return {
    platform: platformName(process.platform),
    env: process.env,
    run: async (command) => {
      try {
        const child = Bun.spawn([...command], {
          stdin: "ignore",
          stdout: "pipe",
          stderr: "pipe",
        });
        const [stdout, stderr, exitCode] = await Promise.all([
          new Response(child.stdout).arrayBuffer(),
          new Response(child.stderr).arrayBuffer(),
          child.exited,
        ]);
        return {
          stdout: decoder.decode(stdout).trimEnd(),
          stderr: decoder.decode(stderr).trimEnd(),
          exitCode,
        };
      } catch (error) {
        return {
          stdout: "",
          stderr: error instanceof Error ? error.message : String(error),
          exitCode: 127,
        };
      }
    },
    hasCommand: (command) => Bun.which(command) !== null,
    readText: async (path) => {
      const file = Bun.file(path);
      return (await file.exists()) ? file.text() : undefined;
    },
    now: Date.now,
    ...overrides,
  };
}

function clean(value: string | undefined, fallback = ""): string {
  return value?.trim().replace(/\s+/g, " ") || fallback;
}

function number(value: string | undefined, fallback = 0): number {
  const parsed = Number.parseFloat(value ?? "");
  return Number.isFinite(parsed) ? parsed : fallback;
}

function capitalize(value: string): string {
  return value ? value[0]!.toUpperCase() + value.slice(1) : value;
}

function valueAfterColon(output: string, label: RegExp): string {
  for (const line of output.split("\n")) {
    const match = line.match(/^\s*([^:]+):\s*(.*)$/);
    if (match && label.test(clean(match[1]))) return clean(match[2]);
  }
  return "";
}

function parseOSRelease(contents: string): Record<string, string> {
  const entries: Record<string, string> = {};
  for (const rawLine of contents.split("\n")) {
    const line = rawLine.trim();
    if (!line || line.startsWith("#")) continue;
    const separator = line.indexOf("=");
    if (separator < 1) continue;
    const key = line.slice(0, separator);
    let value = line.slice(separator + 1).trim();
    if (
      value.length >= 2 &&
      ((value.startsWith('"') && value.endsWith('"')) ||
        (value.startsWith("'") && value.endsWith("'")))
    ) {
      value = value.slice(1, -1);
    }
    entries[key] = value.replace(/\\([\\"$`])/g, "$1");
  }
  return entries;
}

export async function collectOS(context: ProbeContext): Promise<OSReport> {
  if (context.platform === "darwin") {
    const [name, version, build, uname, release] = await Promise.all([
      context.run(["sw_vers", "-productName"]),
      context.run(["sw_vers", "-productVersion"]),
      context.run(["sw_vers", "-buildVersion"]),
      context.run(["uname"]),
      context.run(["uname", "-r"]),
    ]);
    return {
      name: clean(`${name.stdout} ${version.stdout} ${build.stdout}`, "macOS"),
      kernel: clean(`${uname.stdout} ${release.stdout}`, "Darwin"),
    };
  }

  const [osRelease, uname, release] = await Promise.all([
    context.readText("/etc/os-release"),
    context.run(["uname"]),
    context.run(["uname", "-r"]),
  ]);
  const fields = parseOSRelease(osRelease ?? "");
  const id = capitalize(fields.ID || context.platform);
  const version = fields.VERSION_ID || fields.VERSION || "";
  const codename = capitalize(fields.VERSION_CODENAME || "");
  return {
    name: clean(`${id} ${version} ${codename}`, clean(uname.stdout, "Unknown")),
    kernel: clean(`${uname.stdout} ${release.stdout}`, "Unknown"),
  };
}

export function parseIPOutput(output: string): string | undefined {
  for (const line of output.split("\n")) {
    const match = line.match(/^\d+:\s+([^\s]+).*?\sinet6?\s+([^\s/]+)/);
    if (!match) continue;
    const device = match[1]!.replace(/@.*$/, "");
    if (/^(lo|docker|br-|veth)/.test(device)) continue;
    const address = match[2]!;
    if (address !== "::1" && !address.startsWith("fe80:")) return address;
  }
  return undefined;
}

export function parseIfconfig(output: string): string | undefined {
  let device = "";
  for (const line of output.split("\n")) {
    const header = line.match(/^([^\s:]+):?\s/);
    if (header) device = header[1]!;
    if (/^(lo|docker|utun|awdl|llw|bridge|veth)/.test(device)) continue;
    const v4 = line.match(/\binet\s+(?:addr:)?([^\s]+)/);
    if (v4 && v4[1] !== "127.0.0.1") return v4[1];
    const v6 = line.match(/\binet6\s+(?:addr:\s*)?([^\s/%]+)/);
    if (v6 && v6[1] !== "::1" && !v6[1]!.startsWith("fe80:")) return v6[1];
  }
  return undefined;
}

function parseDNS(contents: string): string[] {
  const addresses: string[] = [];
  for (const match of contents.matchAll(
    /(?:^nameserver\s+|nameserver\[\d+\]\s*:\s*)([0-9a-f.:]+)/gim,
  )) {
    if (!addresses.includes(match[1]!)) addresses.push(match[1]!);
    if (addresses.length === 3) break;
  }
  return addresses;
}

export async function collectNetwork(context: ProbeContext): Promise<NetworkReport> {
  const hostnameCommand = context.hasCommand("hostname")
    ? context.run(["hostname", "-f"])
    : context.run(["uname", "-n"]);
  const addressCommand = context.hasCommand("ip")
    ? context.run(["ip", "-o", "addr", "show"])
    : context.hasCommand("ifconfig")
      ? context.run(["ifconfig"])
      : Promise.resolve({ stdout: "", stderr: "", exitCode: 127 });
  const dnsSource =
    context.platform === "darwin" && context.hasCommand("scutil")
      ? context.run(["scutil", "--dns"]).then((result) => result.stdout)
      : context.readText("/etc/resolv.conf").then((contents) => contents ?? "");

  const [user, hostnameResult, addressResult, who, dns] = await Promise.all([
    context.run(["whoami"]),
    hostnameCommand,
    addressCommand,
    context.run(["who", "am", "i"]),
    dnsSource,
  ]);

  let hostname = clean(hostnameResult.stdout);
  if (!hostname && context.hasCommand("hostname")) {
    hostname = clean((await context.run(["hostname"])).stdout);
  }
  const address = context.hasCommand("ip")
    ? parseIPOutput(addressResult.stdout)
    : parseIfconfig(addressResult.stdout);
  const client = who.stdout.match(/\(([^)]+)\)\s*$/)?.[1];
  return {
    hostname: hostname || "Not Defined",
    machineIP: address || "No IP found",
    clientIP: clean(client, "Not connected"),
    dnsIPs: parseDNS(dns),
    currentUser: clean(user.stdout, context.env.USER || "Unknown"),
  };
}

export function parseLoadAverage(output: string): [number, number, number] {
  const match = output.match(/load averages?:\s*([0-9.,]+)[, ]+\s*([0-9.,]+)[, ]+\s*([0-9.,]+)/i);
  return match
    ? [
        number(match[1]!.replace(",", ".")),
        number(match[2]!.replace(",", ".")),
        number(match[3]!.replace(",", ".")),
      ]
    : [0, 0, 0];
}

export async function collectCPU(context: ProbeContext): Promise<CPUReport> {
  if (context.platform === "darwin") {
    const [model, hardwareModel, cores, physical, frequency, virtualized, uptime] =
      await Promise.all([
        context.run(["sysctl", "-n", "machdep.cpu.brand_string"]),
        context.run(["sysctl", "-n", "hw.model"]),
        context.run(["sysctl", "-n", "hw.ncpu"]),
        context.run(["sysctl", "-n", "hw.physicalcpu"]),
        context.run(["sysctl", "-n", "hw.cpufrequency"]),
        context.run(["sysctl", "-n", "kern.hv_vmm_present"]),
        context.run(["uptime"]),
      ]);
    const frequencyHz = number(frequency.stdout);
    return {
      model: clean(model.stdout, clean(hardwareModel.stdout, "Unknown")),
      cores: Math.max(1, number(cores.stdout, 1)),
      coresPerSocket: Math.max(1, number(physical.stdout, number(cores.stdout, 1))),
      sockets: 1,
      hypervisor: clean(virtualized.stdout) === "1" ? "Virtualized" : "Bare Metal",
      frequencyGHz: frequencyHz > 0 ? frequencyHz / 1_000_000_000 : undefined,
      loadAverage: parseLoadAverage(uptime.stdout),
    };
  }

  const [lscpu, cpuinfo, nproc, uptime] = await Promise.all([
    context.hasCommand("lscpu")
      ? context.run(["lscpu"])
      : Promise.resolve({ stdout: "", stderr: "", exitCode: 127 }),
    context.readText("/proc/cpuinfo"),
    context.hasCommand("nproc")
      ? context.run(["nproc", "--all"])
      : Promise.resolve({ stdout: "", stderr: "", exitCode: 127 }),
    context.run(["uptime"]),
  ]);
  const info = cpuinfo ?? "";
  const detectedCores = Math.max(
    1,
    number(nproc.stdout, (info.match(/^processor\s*:/gm) ?? []).length || 1),
  );
  const model =
    valueAfterColon(lscpu.stdout, /^Model name$/i) ||
    valueAfterColon(info, /^(model name|Model|Hardware)$/i);
  const coresPerSocket = number(
    valueAfterColon(lscpu.stdout, /^Core\(s\) per socket$/i),
    detectedCores,
  );
  const sockets = number(valueAfterColon(lscpu.stdout, /^Socket\(s\)$/i), 1);
  const hypervisor = valueAfterColon(lscpu.stdout, /^Hypervisor vendor$/i);
  const mhz = number(valueAfterColon(info, /^cpu MHz$/i));
  return {
    model: clean(model, `Unknown (${detectedCores} cores)`),
    cores: detectedCores,
    coresPerSocket: Math.max(1, coresPerSocket),
    sockets: Math.max(1, sockets),
    hypervisor: clean(hypervisor, "Bare Metal"),
    frequencyGHz: mhz > 0 ? mhz / 1_000 : undefined,
    loadAverage: parseLoadAverage(uptime.stdout),
  };
}

export async function collectMemory(context: ProbeContext): Promise<MemoryReport> {
  if (context.platform === "darwin") {
    const [total, pageSize, vmStat] = await Promise.all([
      context.run(["sysctl", "-n", "hw.memsize"]),
      context.run(["sysctl", "-n", "hw.pagesize"]),
      context.run(["vm_stat"]),
    ]);
    const totalKiB = number(total.stdout) / 1024;
    const pages = (label: string) =>
      number(vmStat.stdout.match(new RegExp(`^Pages ${label}:\\s+(\\d+)\\.`, "m"))?.[1]);
    const availablePages = pages("free") + pages("inactive") + pages("speculative");
    const availableKiB = (availablePages * number(pageSize.stdout, 4096)) / 1024;
    return { totalKiB, usedKiB: Math.max(0, totalKiB - availableKiB) };
  }

  const meminfo = (await context.readText("/proc/meminfo")) ?? "";
  const value = (label: string) =>
    number(meminfo.match(new RegExp(`^${label}:\\s+(\\d+)`, "m"))?.[1]);
  const totalKiB = value("MemTotal");
  const availableKiB = value("MemAvailable") || value("MemFree");
  return { totalKiB, usedKiB: Math.max(0, totalKiB - availableKiB) };
}

export async function collectDisk(context: ProbeContext): Promise<DiskReport> {
  const result = await context.run(["df", "-Pm", "/"]);
  const fields = result.stdout.trim().split("\n").at(-1)?.trim().split(/\s+/) ?? [];
  return {
    totalMiB: number(fields[1]),
    usedMiB: number(fields[2]),
  };
}

function formatDuration(seconds: number): string {
  const whole = Math.max(0, Math.floor(seconds));
  const days = Math.floor(whole / 86_400);
  const hours = Math.floor((whole % 86_400) / 3_600);
  const minutes = Math.floor((whole % 3_600) / 60);
  return [days ? `${days}d` : "", hours ? `${hours}h` : "", `${minutes}m`]
    .filter(Boolean)
    .join(" ");
}

function parseMacLogin(line: string): Pick<LoginReport, "lastLogin" | "lastLoginIP"> {
  const fields = line.trim().split(/\s+/);
  if (fields.length < 6) return { lastLogin: "Never logged in" };
  const weekday = /^(Mon|Tue|Wed|Thu|Fri|Sat|Sun)$/;
  const weekdayIndex = fields.findIndex((field, index) => index >= 2 && weekday.test(field));
  if (weekdayIndex < 0) return { lastLogin: "Never logged in" };
  const candidateIP = fields[2];
  return {
    lastLogin: fields.slice(weekdayIndex, weekdayIndex + 4).join(" "),
    lastLoginIP: candidateIP && /^\d+(?:\.\d+){3}$/.test(candidateIP) ? candidateIP : undefined,
  };
}

function parseLastlog(output: string): Pick<LoginReport, "lastLogin" | "lastLoginIP"> {
  const line = output.split("\n").find((value, index) => index > 0 && value.trim());
  if (!line || /Never logged in/i.test(line)) return { lastLogin: "Never logged in" };
  const ip = line.match(/\b\d+(?:\.\d+){3}\b/)?.[0];
  const date = line.match(
    /(?:Mon|Tue|Wed|Thu|Fri|Sat|Sun)\s+\w+\s+\d+\s+[\d:]+(?:\s+[+-]\d{4})?\s+\d{4}/,
  )?.[0];
  return { lastLogin: clean(date, "Never logged in"), lastLoginIP: ip };
}

export async function collectLogin(context: ProbeContext): Promise<LoginReport> {
  const user = context.env.USER || clean((await context.run(["whoami"])).stdout);
  if (context.platform === "darwin") {
    const [last, boot] = await Promise.all([
      context.run(["last", "-1", user]),
      context.run(["sysctl", "-n", "kern.boottime"]),
    ]);
    const login = parseMacLogin(last.stdout.split("\n")[0] ?? "");
    const bootSeconds = number(boot.stdout.match(/sec\s*=\s*(\d+)/)?.[1]);
    return {
      ...login,
      uptime: bootSeconds ? formatDuration(context.now() / 1000 - bootSeconds) : "Unknown",
    };
  }

  const loginPromise = context.hasCommand("lastlog")
    ? context.run(["lastlog", "-u", user])
    : context.run(["last", "-1", user]);
  const [last, uptime] = await Promise.all([loginPromise, context.run(["uptime", "-p"])]);
  const login = context.hasCommand("lastlog")
    ? parseLastlog(last.stdout)
    : parseMacLogin(last.stdout.split("\n")[0] ?? "");
  return {
    ...login,
    uptime: clean(
      uptime.stdout
        .replace(/^up\s*/, "")
        .replace(/\s+days?/g, "d")
        .replace(/\s+hours?/g, "h")
        .replace(/\s+minutes?/g, "m"),
      "Unknown",
    ),
  };
}

export async function collectMachineReport(
  context: ProbeContext = createProbeContext(),
): Promise<MachineReport> {
  const defaultTitle = `${context.env.USER || "Unknown"} @ ${context.env.HOSTNAME || ""}`;
  const titlePromise = context.env.TR100_TITLE
    ? Promise.resolve(context.env.TR100_TITLE)
    : Promise.all([context.run(["whoami"]), context.run(["hostname", "-s"])]).then(([user, host]) =>
        clean(`${user.stdout} @ ${host.stdout}`, clean(defaultTitle, "Machine")),
      );
  const [title, os, network, cpu, memory, disk, login] = await Promise.all([
    titlePromise,
    collectOS(context),
    collectNetwork(context),
    collectCPU(context),
    collectMemory(context),
    collectDisk(context),
    collectLogin(context),
  ]);
  return { title, os, network, cpu, memory, disk, login };
}

function percent(used: number, total: number): number {
  return total > 0 ? Math.max(0, Math.min(100, (used / total) * 100)) : 0;
}

export function barGraph(used: number, total: number, width: number): string {
  const blocks = Math.max(0, Math.min(width, Math.floor((percent(used, total) / 100) * width)));
  return "█".repeat(blocks) + "░".repeat(width - blocks);
}

function firstWrappedLine(value: string, width: number): string {
  const wrapped = Bun.wrapAnsi(value.replace(/[\r\n]+/g, " "), width, { hard: true });
  const [first = "", ...rest] = wrapped.split("\n");
  if (rest.length === 0 && Bun.stringWidth(first) <= width) return first;
  if (width <= 3) return Bun.sliceAnsi(first, 0, width);
  return Bun.sliceAnsi(first, 0, width - 3) + "...";
}

function padCell(value: string, width: number): string {
  const fitted = firstWrappedLine(value, width);
  return fitted + " ".repeat(Math.max(0, width - Bun.stringWidth(fitted)));
}

function dataWidth(report: MachineReport): number {
  const candidates = [
    report.title,
    report.os.name,
    report.os.kernel,
    report.network.hostname,
    report.network.machineIP,
    report.network.clientIP,
    report.network.currentUser,
    report.cpu.model,
    `${report.cpu.coresPerSocket} vCPU(s) / ${report.cpu.sockets} Socket(s)`,
    report.cpu.hypervisor,
    report.login.lastLogin,
    report.login.lastLoginIP || "",
    report.login.uptime,
  ];
  const widest = Math.max(...candidates.map((value) => Bun.stringWidth(value)));
  return Math.max(MIN_DATA_WIDTH, Math.min(MAX_DATA_WIDTH, widest));
}

export function renderMachineReport(report: MachineReport): string {
  const width = dataWidth(report);
  const totalWidth = width + NAME_WIDTH + 7;
  const lines: string[] = [];
  const row = (name: string, value: string) => {
    lines.push(`│ ${padCell(name, NAME_WIDTH)} │ ${padCell(value, width)} │`);
  };
  const divider = (position: "middle" | "bottom" = "middle") => {
    const left = position === "bottom" ? "└" : "├";
    const join = position === "bottom" ? "┴" : "┼";
    const right = position === "bottom" ? "┘" : "┤";
    lines.push(`${left}${"─".repeat(NAME_WIDTH + 2)}${join}${"─".repeat(width + 2)}${right}`);
  };
  const centered = (value: string) => {
    const fitted = firstWrappedLine(value, totalWidth - 2);
    const remaining = totalWidth - 2 - Bun.stringWidth(fitted);
    const left = Math.floor(remaining / 2);
    lines.push(`│${" ".repeat(left)}${fitted}${" ".repeat(remaining - left)}│`);
  };
  const metric = (value: number) => value.toFixed(2);

  lines.push(`┌${"┬".repeat(totalWidth - 2)}┐`);
  centered(report.title);
  centered("TR-100 MACHINE REPORT");
  lines.push(`├${"┴".repeat(totalWidth - 2)}┤`);
  row("OS", report.os.name);
  row("KERNEL", report.os.kernel);
  divider();
  row("HOSTNAME", report.network.hostname);
  row("MACHINE IP", report.network.machineIP);
  row("CLIENT  IP", report.network.clientIP);
  report.network.dnsIPs.forEach((dns, index) => row(`DNS  IP ${index + 1}`, dns));
  row("USER", report.network.currentUser);
  divider();
  row("PROCESSOR", report.cpu.model);
  row("CORES", `${report.cpu.coresPerSocket} vCPU(s) / ${report.cpu.sockets} Socket(s)`);
  row("HYPERVISOR", report.cpu.hypervisor);
  if (report.cpu.frequencyGHz) row("CPU FREQ", `${metric(report.cpu.frequencyGHz)} GHz`);
  row("LOAD  1m", barGraph(report.cpu.loadAverage[0], report.cpu.cores, width));
  row("LOAD  5m", barGraph(report.cpu.loadAverage[1], report.cpu.cores, width));
  row("LOAD 15m", barGraph(report.cpu.loadAverage[2], report.cpu.cores, width));
  divider();
  row(
    "VOLUME",
    report.disk.totalMiB > 0
      ? `${metric(report.disk.usedMiB / 1024)}/${metric(report.disk.totalMiB / 1024)} GB [${metric(percent(report.disk.usedMiB, report.disk.totalMiB))}%]`
      : "Unknown",
  );
  row("DISK USAGE", barGraph(report.disk.usedMiB, report.disk.totalMiB, width));
  divider();
  row(
    "MEMORY",
    report.memory.totalKiB > 0
      ? `${metric(report.memory.usedKiB / 1_048_576)}/${metric(report.memory.totalKiB / 1_048_576)} GiB [${metric(percent(report.memory.usedKiB, report.memory.totalKiB))}%]`
      : "Unknown",
  );
  row("USAGE", barGraph(report.memory.usedKiB, report.memory.totalKiB, width));
  divider();
  row("LAST LOGIN", report.login.lastLogin);
  if (report.login.lastLoginIP) row("", report.login.lastLoginIP);
  row("UPTIME", report.login.uptime);
  divider("bottom");
  return lines.join("\n") + "\n";
}

export async function main(): Promise<void> {
  process.stdout.write(renderMachineReport(await collectMachineReport()));
}

if (import.meta.main) {
  await main();
}
