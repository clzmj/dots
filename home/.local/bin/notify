#!/usr/bin/env bun
// Run a command and emit an OSC 777 desktop notification when it finishes.

export function formatDuration(milliseconds) {
  const duration = Math.max(0, Math.floor(milliseconds / 1000));
  const hours = Math.floor(duration / 3600);
  const minutes = Math.floor((duration % 3600) / 60);
  const seconds = duration % 60;
  if (hours > 0) return `${hours}h ${minutes}m`;
  if (minutes > 0) return `${minutes}m ${seconds}s`;
  return `${seconds}s`;
}

export async function main(args = process.argv.slice(2)) {
  if (args.length === 0) {
    console.error("usage: notify command [args ...]");
    return 2;
  }

  const started = performance.now();
  let status = 127;
  try {
    const child = Bun.spawn(args, {
      stdin: "inherit",
      stdout: "inherit",
      stderr: "inherit",
    });
    status = await child.exited;
  } catch (error) {
    console.error(error instanceof Error ? error.message : String(error));
  }

  const elapsed = formatDuration(performance.now() - started);
  const message =
    status === 0
      ? `✅ Succeeded after ${elapsed}`
      : `❌ Failed (status: ${status}) after ${elapsed}`;
  process.stdout.write(`\u001b]777;notify;;${message}\u0007`);

  // Historical behavior: the notification reports failure while notify itself succeeds.
  return 0;
}

if (import.meta.main) process.exit(await main());
